#!/usr/bin/env bash
# megh - a thin CLI over per-provider backends.
#
# The provider abstraction lives HERE, not in any single provider's tooling.
# Each backend under providers/<name>/ uses whatever launches that provider
# most reliably (RunPod: REST API; Hetzner: OpenTofu, added later). This keeps
# provider switching a first-class, early capability instead of a rewrite.
#
# Usage:
#   megh up   --provider runpod [--flavor base] [--vcpu N] [--ram GB]
#   megh down --provider runpod --id <pod-id>        (not yet implemented)
#   megh list --provider runpod                      (not yet implemented)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROVIDER=""
CMD="${1:-}"; shift || true

# Parse common flags; provider backends read the rest from MEGH_* env vars so
# the surface stays small while we shake the design out.
while [ $# -gt 0 ]; do
  case "$1" in
    --provider) PROVIDER="$2"; shift 2 ;;
    --flavor)   export MEGH_FLAVOR="$2"; shift 2 ;;
    --vcpu)     export MEGH_VCPU="$2"; shift 2 ;;
    --ram)      export MEGH_RAM="$2"; shift 2 ;;
    --id)       export MEGH_ID="$2"; shift 2 ;;
    *) echo "megh: unknown flag: $1" >&2; exit 2 ;;
  esac
done

if [ -z "${PROVIDER}" ]; then
  echo "megh: --provider is required (runpod)" >&2
  exit 2
fi

backend="${ROOT}/providers/${PROVIDER}"
if [ ! -d "${backend}" ]; then
  echo "megh: no backend for provider '${PROVIDER}'" >&2
  exit 2
fi

case "${CMD}" in
  up)
    exec bash "${backend}/launch.sh"
    ;;
  down|list|shell)
    echo "megh: '${CMD}' not implemented for ${PROVIDER} yet" >&2
    exit 1
    ;;
  ""|-h|--help|help)
    grep '^#' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "megh: unknown command '${CMD}'" >&2
    exit 2
    ;;
esac
