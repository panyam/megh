# megh secrets template.
#
# Copy the VALUES into your shell environment (e.g. ~/personal/envvars) and
# `source` it. These are the env vars that megh.yaml points at by name. NEVER
# put the values in the repo: git history is permanent.
#
#   cp secrets.env.example ~/personal/megh.env   # then fill in and source it
#
# Required
export RUNPOD_API_KEY=          # RunPod account API key
export GH_MEGH_TOKEN=           # GitHub classic PAT, read:packages (GHCR pull + `megh registry`)
#
# Optional
export TS_AUTHKEY=              # Tailscale auth key (reusable+ephemeral); only for phone/tablet
export MEGH_TAILSCALE_CLIENT_ID=      # optional Tailscale trust credential (OAuth), preferred form.
export MEGH_TAILSCALE_CLIENT_SECRET=  # Deletes stale tailnet nodes and mints per-box auth keys.
export MEGH_TAILSCALE_API_KEY=        # older single-value form (PAT). Any of these are control
                                      # machine ONLY, never sent to a box (CONSTRAINTS C5).
