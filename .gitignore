# Local, per-machine Claude Code settings (not shared).
.claude/settings.local.json

# OS / editor cruft.
.DS_Store
*.swp

# Compiled megh binary (build output).
/bin/megh

# CI-staged artifacts baked into the dev-env image (see build-env.yml).
env/base/megh
env/base/megh.yaml

# Local secrets — NEVER commit. Keep values in the environment (e.g.
# ~/personal/envvars), never in the repo; git history is permanent. The
# *.example templates are safe and stay tracked.
secrets.env
*.secret.env
megh.local.yaml

# Repo-local profile store (opt-in via MEGH_HOME=./.megh). Holds private keys
# and secret values. The canonical location is ~/.megh (outside the repo).
.megh/

# Session handoff notes (perishable, per-machine). Untracked so a `git add .`
# does not sweep them into the repo.
HANDOFF_*.md
