# megh configuration template.
#
# Copy to megh.yaml and adjust. This file holds settings and POINTERS to secrets
# (env-var names), never secret values. Put the actual secret values in your
# environment (see secrets.env.example); this file only names the env vars.
#
# Config is auto-discovered as megh.yaml walking up from the cwd, then
# ~/.config/megh/megh.yaml. Override with --config or $MEGH_CONFIG.
#
# Precedence for `megh up`: flag > env var > this file > built-in default.

# Which provider `megh up` targets when --provider/$MEGH_PROVIDER are unset.
default_provider: runpod

# Which dev-env flavor to launch; the image is megh-<flavor>.
default_flavor: base

# SSH public key injected into boxes (its private key auths you in).
ssh_pubkey_file: ~/.ssh/id_ed25519.pub

# OCI registries megh inspects / pulls dev-env images from. The first is the
# default. token_env NAMES the env var holding a read:packages token.
registries:
  - name: ghcr
    host: ghcr.io
    namespace: YOUR_GH_NAMESPACE
    username: YOUR_GH_USERNAME
    token_env: GH_MEGH_TOKEN

# Dev-env flavors that exist as images (megh-<flavor>).
flavors: [base]

# Per-provider defaults. api_key_env NAMES the env var holding the API key.
providers:
  runpod:
    api_key_env: RUNPOD_API_KEY
    default_dc: US-CA-2            # a data center that has CPU + your volume
    default_volume: YOUR_VOLUME_ID # from `megh storage list`
    vcpu: 2
    ram: 8
    disk: 20                       # ephemeral container disk (capped by size)
    expose_ssh: true               # false = zero public ports, reach the box over the tailnet

# Optional: private mesh for phone/tablet browser access. Leave the env value
# unset for SSH-only (Mac reaches boxes via `megh ssh`).
tailscale:
  authkey_env: TS_AUTHKEY
  # Optional control-plane token, used only from this machine, to delete tailnet
  # nodes whose box is gone. Never sent to a box (CONSTRAINTS.md C5).
  api_key_env: MEGH_TAILSCALE_API_KEY
  # Preferred: the client id + secret pair the console gives you.
  client_id_env: MEGH_TAILSCALE_CLIENT_ID
  client_secret_env: MEGH_TAILSCALE_CLIENT_SECRET
  # Mint a single-use ephemeral key per box instead of sharing one static key.
  # Needs tag:megh in the ACL tagOwners plus an ssh rule for dst: ["tag:megh"],
  # and a trust credential scoped to Devices>Core>Write + Keys>Auth Keys>Write.
  mint_keys: false
  tag: tag:megh

# Optional: your tailnet's MagicDNS suffix (see `megh doctor ts status` Self DNSName),
# used to build box surface URLs in the portal.
# tailnet: tailXXXXXX.ts.net

# Optional: `megh portal` publishes a bookmarkable box+URL index (PORTAL.md) to a
# branch of a private repo, so on mobile you tap a link instead of typing host:port.
# GitHub renders Markdown in a private repo for you; bookmark PORTAL.md on that
# branch. megh up/down refresh it. scheme: http (or https once your tailnet has
# HTTPS certs). Omit this block to disable.
# portal:
#   repo: git@github.com:YOUR_GH_NAMESPACE/megh.git
#   branch: portal
#   scheme: http

# Optional: durable, searchable agent history. repo is a private git repo;
# token_env NAMES a fine-grained PAT with contents:write on ONLY that repo.
sessions:
  repo: YOUR_GH_NAMESPACE/megh-sessions
  # No token: the control machine collects and pushes; boxes hold no credential.

# Home dirs symlinked onto the scratch volume so their state survives box rebuilds
# (log in once, stay logged in on the next box that mounts the same volume). Add a
# tool's config/auth dir to bake its sign-in in. Defaults to ~/.claude, ~/.codex.
persist:
  - ~/.claude
  - ~/.codex
  # - ~/.config/gh
  # - ~/.aws

# Map home paths onto volume locations so local paths/scripts work on the box.
# Targets are relative to /mnt/work (or absolute); filled by `megh hydrate`.
# symlinks:
#   ~/newstack: repos/newstack
#   ~/projects: repos/projects

# Copy local files onto the box over SSH (mode 0600) — rc files and secret files
# that must NOT go in a repo/image. local_path: box_path. A ~/ dest is ephemeral
# (/root, re-copied each connect); a /mnt/work/ dest persists on the volume.
# SECURITY: never copy a file with RUNPOD_API_KEY — a box with it can manage your
# OTHER boxes. Scope it. Versioned dotfiles belong in a repo (repos: + symlinks:).
# files:
#   ~/.netrc: ~/.netrc

# GitHub identity (profile gh key name) for repos that don't set `key`.
default_gh_key: personal

# Repos cloned into /mnt/work/repos by `megh hydrate`. Each authenticates as a
# GitHub identity from the active profile (its `key`, else default_gh_key), via a
# forwarded key and a per-identity Host alias; private keys never touch the box.
# `megh hydrate --check` reports drift.
repos:
  - git@github.com:YOUR_GH_NAMESPACE/some-repo.git          # uses default_gh_key
  - {url: git@github.com:OTHER_ORG/other-repo.git, key: work}

# Env vars that must be set on the host. megh blocks `megh up` if any is missing.
# box_envs are also copied into the box for the repos/services there (they land
# on a third-party VM, so list only what the box needs).
requires:
  envs:
    - RUNPOD_API_KEY
    - GH_MEGH_TOKEN
  box_envs:
    - OPENAI_API_KEY

# MagicDNS suffix of your tailnet, used to build box surface URLs in the portal.
# Find it in `megh doctor ts status` (Self DNSName).
tailnet: example.ts.net

# `megh portal`: a bookmarkable box+URL index force-pushed to a branch of a
# private repo, so on mobile you tap a link instead of typing host:port.
portal:
  repo: git@github.com:YOUR_GH_NAMESPACE/YOUR_REPO.git
  branch: portal
  scheme: http

# Home paths mapped onto volume locations, so paths your local scripts expect
# resolve on the box. Targets are relative to /mnt/work unless absolute, and may
# be files or dirs that do not exist until `megh hydrate` runs.
symlinks:
  ~/projects: repos/projects
  ~/.zshrc:   repos/dotfiles/YOUR_DOTFILES_REPO/box/zshrc

# Copy LOCAL files onto a box over SSH (local_path: box_path, mode 0600). For
# secrets and machine rc files that must not live in a repo or the image. A ~/
# box path is ephemeral; a /mnt/work/ path persists on the volume.
#
# SECURITY: never copy a file containing a provider credential. A box holding one
# can terminate and launch your OTHER boxes (CONSTRAINTS.md C3).
files:
  ~/personal/box-envvars: /mnt/work/state/personal/envvars
