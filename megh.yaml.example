# megh configuration template.
#
# Copy to megh.yaml and adjust. This file holds settings and POINTERS to secrets
# (env-var names), never secret values. Put the actual secret values in your
# environment (see secrets.env.example); this file only names the env vars.
#
# Config is auto-discovered as megh.yaml walking up from the cwd, then
# ~/.config/megh/megh.yaml. Override with --config or $MEGH_CONFIG.
#
# Precedence for `megh up`: flag > env var > this file > built-in default.

# macOS + iTerm2 only: default profile for interactive `megh ssh` / `megh tmux attach`.
# megh installs it under ~/Library/Application Support/iTerm2/DynamicProfiles/
# on first use (`megh iterm install`). Override or disable here; env MEGH_ITERM=0
# and `megh ssh --no-iterm` also skip opening that profile.
# iterm:
#   profile: megh          # default for megh ssh; override with --iterm-profile
#   auto: true
#   dir: iterm/profiles    # relative to this file; JSON from `megh iterm save`

# Which provider `megh up` targets when --provider/$MEGH_PROVIDER are unset.
default_provider: runpod

# Which dev-env flavor to launch; the image is megh-<flavor>.
default_flavor: full

# SSH public key injected into boxes (its private key auths you in).
ssh_pubkey_file: ~/.ssh/id_ed25519.pub

# Extra PUBLIC keys every box `megh up` creates will also accept, whichever
# machine launched it. Use it for a key held in a password manager's SSH agent
# (e.g. Bitwarden desktop), so any machine with that agent can reach a box
# another device started. The box's public ip:port is listed in the portal. Public keys
# only: `up` refuses anything that is not one.
# extra_pubkeys:
#   - ssh-ed25519 AAAA... megh-access (password manager)

# The hosted web control plane (cmd/meghplane, SETUP.md section 7). Only these
# Google accounts get in, checked against IAP's signed header; the app refuses
# to start with the list empty. Keep it here, not in app.yaml: this file is
# private and travels with the deploy, app.yaml is public.
# secret, if set, names a Secret Manager secret holding your control-plane
# note (RUNPOD_API_KEY=..., MEGH_TAILSCALE_CLIENT_ID=..., ..._SECRET=...). Keys
# found there are used for every request and the page stops asking for them;
# any it lacks are taken from the browser.
# serve:
#   allowed_emails:
#     - you@example.com
#   secret: megh-control

# OCI registries megh inspects / pulls dev-env images from. The first is the
# default. token_env NAMES the env var holding a read:packages token.
registries:
  - name: ghcr
    host: ghcr.io
    namespace: YOUR_GH_NAMESPACE
    username: YOUR_GH_USERNAME
    token_env: GH_MEGH_TOKEN

# Dev-env flavors that exist as images (megh-<flavor>).
flavors: [full]

# Per-provider defaults. api_key_env NAMES the env var holding the API key.
providers:
  runpod:
    api_key_env: RUNPOD_API_KEY
    default_dc: US-CA-2            # a data center that has CPU + your volume
    default_volume: YOUR_VOLUME_ID # from `megh storage list`
    vcpu: 2
    ram: 8
    disk: 20                       # ephemeral container disk (capped by size)
    expose_ssh: true               # false = zero public ports, reach the box over the tailnet

  # Hetzner Cloud: a box is a VM running the megh image under Docker, sized per
  # launch from Hetzner's server types (the cheapest x86 type with at least the
  # vCPU/RAM/disk asked for). A volume is required and fixes the location
  # (US: ash, hil). SETUP.md section 8. `megh up --provider hetzner <name>`.
  hetzner:
    api_key_env: HCLOUD_TOKEN      # a project API token (read/write)
    # default_dc: ash
    # default_volume: "12345678"   # from `megh storage list`
    vcpu: 2
    ram: 4
    disk: 40
    expose_ssh: true               # the box's sshd on <vm-ip>:2222; the VM's own sshd is off

  # Vultr: the same VM-runs-the-image shape as Hetzner, sized per launch from
  # Vultr's plans, with 9 US regions (ewr, ord, atl, sea, mia, dfw, sjc, lax,
  # hnl). Volumes arrive blank; the first box formats one, later boxes only
  # mount it. SETUP.md section 9. `megh up --provider vultr <name>`.
  vultr:
    api_key_env: VULTR_API_KEY     # allow your machines' IPs on the key (Vultr API keys have an IP allowlist)
    # default_dc: ewr
    # default_volume: "<block id>" # from `megh storage list`
    block_type: high_perf          # NVMe; storage_opt is HDD, cheaper, fewer regions
    vcpu: 2
    ram: 4
    disk: 50
    expose_ssh: true

  # The LOCAL backend: a box is a container on this machine. Free, instant, and
  # the work trees are host paths, so an agent in the box edits your real repos.
  # `megh up --provider docker <name>`; list/ssh/down/enable/browse are unchanged.
  #
  # It is NOT a security sandbox. Anything mounted read-write can be deleted from
  # inside. What it does isolate is the rest of the machine.
  docker:
    # Built by `make image-local-full` (or `-slim`) for this machine's
    # architecture. The published images are linux/amd64 only, so on an arm64
    # laptop they would emulate. One tag per flavor, so the two do not overwrite
    # each other and a box picks its flavor by naming the tag here.
    image: megh-local-full:arm64
    # The docker context (daemon) megh talks to: `docker context ls` names them.
    # Absent follows the shell's active context, which is fine with one daemon.
    # With two (colima and Docker Desktop), pin it: a box lives in ONE daemon,
    # and asking the other one makes it vanish from list/ssh/down. The image
    # must be built into the same daemon (`docker context use <it>` before
    # `make image-local-*`).
    # context: colima
    # The host directory bound at the box's work mount: docker's network volume.
    # Tool logins persist here, separately from the host's own ~/.claude, so one
    # `claude login` in the box survives rebuilds and never touches yours.
    work_dir: ~/.megh/volumes/local
    # Where `megh storage create|list|rm` puts local volumes.
    volume_root: ~/.megh/volumes
    # The overlay network this backend's boxes may join. Absent means none, which
    # is right when you only ever reach the box from this machine: `megh browse`
    # tunnels the surfaces over SSH and needs nothing else.
    #
    # Set it when another device has to reach the box (a phone), since a tunnel
    # only reaches the machine that opened it. A local box then joins WHEN ASKED,
    # never at create: `megh mesh join <box>`. Naming the vendor rather than
    # saying true keeps the setting honest if there is ever a second one; an
    # unknown value is an error at load.
    # mesh: tailscale
    # Bind mounts, host path -> box path. The box path follows the same
    # convention as a `symlinks:` target: relative to the work mount unless
    # absolute. Add ":ro" for read-only.
    #
    # Point these at the same targets `symlinks:` uses and one megh.yaml serves
    # both backends: on a cloud box ~/projects resolves to a hydrated clone, and
    # here it resolves to your actual tree. No `megh hydrate` needed.
    #
    # This map is the ONLY source of bind mounts (CONSTRAINTS.md C3). Nothing is
    # inferred from the environment or the working directory, because a mount is
    # a channel to a box exactly like pod env and `files:` are.
    mounts:
      ~/projects: repos/projects
      ~/dotfiles: repos/dotfiles
      # Do NOT mount a directory whose entries are absolute host symlinks (a
      # dotfiles-managed dir often is). They dangle in the box, and the
      # entrypoint replaces a dangling symlink rather than skipping it: read-only
      # that ln fails and kills PID 1 under set -euo pipefail, read-write it
      # rewrites your host copy. Mount directories, never single files (an
      # editor's save-by-rename kills a file mount), and let `symlinks:` rebuild
      # the rest against the dotfiles mount. Secret env files need no mount:
      # `files:` below copies them to local boxes too.

# Optional: private mesh for phone/tablet browser access. Leave the env value
# unset for SSH-only (a laptop reaches boxes via `megh ssh`).
tailscale:
  authkey_env: TS_AUTHKEY
  # Optional control-plane token, used only from this machine, to delete tailnet
  # nodes whose box is gone. Never sent to a box (CONSTRAINTS.md C5).
  api_key_env: MEGH_TAILSCALE_API_KEY
  # Preferred: the client id + secret pair the console gives you.
  client_id_env: MEGH_TAILSCALE_CLIENT_ID
  client_secret_env: MEGH_TAILSCALE_CLIENT_SECRET
  # Mint a single-use ephemeral key per box instead of sharing one static key.
  # Needs tag:megh in the ACL tagOwners plus an ssh rule for dst: ["tag:megh"],
  # and a trust credential scoped to Devices>Core>Write + Keys>Auth Keys>Write.
  mint_keys: false
  tag: tag:megh
  # The tag `megh gateway` joins under (SETUP.md section 10).
  # gateway_tag: tag:megh-gw

# Optional: your tailnet's MagicDNS suffix (see `megh doctor ts status` Self DNSName),
# used to build box surface URLs in the portal. `megh gateway` requires it.
# tailnet: tailXXXXXX.ts.net

# Optional: `megh portal` publishes a bookmarkable box+URL index (PORTAL.md) to a
# branch of a private repo, so on mobile you tap a link instead of typing host:port.
# GitHub renders Markdown in a private repo for you; bookmark PORTAL.md on that
# branch. megh up/down refresh it. scheme: http (or https once your tailnet has
# HTTPS certs). Omit this block to disable.
# portal:
#   repo: git@github.com:YOUR_GH_NAMESPACE/megh.git
#   branch: portal
#   scheme: http

# Home dirs symlinked onto the scratch volume so their state survives box rebuilds
# (log in once, stay logged in on the next box that mounts the same volume). Add a
# tool's config/auth dir to bake its sign-in in. Defaults to ~/.claude, ~/.codex.
persist:
  - ~/.claude
  - ~/.codex
  # - ~/.config/gh
  # - ~/.aws

# Map home paths onto volume locations so local paths/scripts work on the box.
# Targets are relative to /mnt/work (or absolute); filled by `megh hydrate`.
# symlinks:
#   ~/projects: repos/projects

# Copy local files onto the box over SSH (mode 0600) — rc files and secret files
# that must NOT go in a repo/image. local_path: box_path. A ~/ dest is ephemeral
# (/root, re-copied each connect); a /mnt/work/ dest persists on the volume.
# SECURITY: never copy a file with RUNPOD_API_KEY — a box with it can manage your
# OTHER boxes. Scope it. Versioned dotfiles belong in a repo (repos: + symlinks:).
# files:
#   ~/.netrc: ~/.netrc

# GitHub identity (profile gh key name) for repos that don't set `key`.
default_gh_key: personal

# Repos cloned into /mnt/work/repos by `megh hydrate`. Each authenticates as a
# GitHub identity from the active profile (its `key`, else default_gh_key), via a
# forwarded key and a per-identity Host alias; private keys never touch the box.
# `megh hydrate --check` reports drift.
repos:
  - git@github.com:YOUR_GH_NAMESPACE/some-repo.git          # uses default_gh_key
  - {url: git@github.com:OTHER_ORG/other-repo.git, key: work}

# Env vars that must be set on the host. megh blocks `megh up` if any is missing.
# box_envs are also copied into the box for the repos/services there (they land
# on a third-party VM, so list only what the box needs).
requires:
  envs:
    - RUNPOD_API_KEY
    - GH_MEGH_TOKEN
  box_envs:
    - OPENAI_API_KEY

# MagicDNS suffix of your tailnet, used to build box surface URLs in the portal.
# Find it in `megh doctor ts status` (Self DNSName).
tailnet: example.ts.net

# `megh portal`: a bookmarkable box+URL index force-pushed to a branch of a
# private repo, so on mobile you tap a link instead of typing host:port.
portal:
  repo: git@github.com:YOUR_GH_NAMESPACE/YOUR_REPO.git
  branch: portal
  scheme: http

# Home paths mapped onto volume locations, so paths your local scripts expect
# resolve on the box. Targets are relative to /mnt/work unless absolute, and may
# be files or dirs that do not exist until `megh hydrate` runs.
symlinks:
  ~/projects: repos/projects
  ~/.zshrc:   repos/dotfiles/YOUR_DOTFILES_REPO/box/zshrc

# Copy LOCAL files onto a box over SSH (local_path: box_path, mode 0600). For
# secrets and machine rc files that must not live in a repo or the image. A ~/
# box path is ephemeral; a /mnt/work/ path persists on the volume.
#
# SECURITY: never copy a file containing a provider credential. A box holding one
# can terminate and launch your OTHER boxes (CONSTRAINTS.md C3).
# A box env file (service tokens a box needs, never a provider key) is the usual
# entry. It lands on the volume, so load it from the box's shell rc, e.g. a line
# `[ -r /mnt/work/state/box.env ] && . /mnt/work/state/box.env` in its zshenv.
files:
  ~/.config/megh/box.env: /mnt/work/state/box.env
